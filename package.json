{
  "name": "my-remix-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "cross-env NODE_ENV=development node hmr.ts",
    "start": "cross-env NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "cross-env NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "volta": {
    "node": "26.13.0"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "remix": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "oxlint": "^1.90.0",
    "typescript": "latest"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
